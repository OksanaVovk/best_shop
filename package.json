{
  "name": "project-template",
  "version": "1.0.0",
  "description": "Capstone Project Template ",
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/campus_javascript/capstone-project/project-template.git"
  },
  "license": "ISC",
  "author": "Oksana Vovk",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "echo \"Dummy build script required for Autocode Compile\"",
    "compile": "sass src/scss/main.scss dist/css/main.css",
    "watch:sass": "sass --watch src/scss/main.scss dist/css/main.css",
    "serve": "live-server --open=src/index.html --mount=/dist:./dist",
    "dev": "concurrently \"npm run watch:sass\" \"npm run serve\"",
    "lint:js": "eslint --config eslint.config.cjs src/**/*.js",
    "lint:css": "stylelint 'src/**/*.{scss,css}'",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "live-server": "^1.2.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sass": "^1.93.3",
    "stylelint": "^16.25.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.12.1"
  }
}
